timescale 1ns / 1ps

module processor_system_tb;

  reg clk = 0;
  reg rst = 1;

  wire [31:0] pc;
  wire [31:0] instruction;
  wire execution_valid;

  integer passed = 0;
  integer failed = 0;

  processor_top dut (
    .clk(clk),
    .rst(rst),
    .pc(pc),
    .instruction(instruction),
    .execution_valid(execution_valid)
  );

  always #5 clk = ~clk;

  task check;
    input [31:0] actual;
    input [31:0] expected;
    begin
      if (actual === expected) begin
        passed = passed + 1;
        $display("PASS expected=%h actual=%h",
                 expected, actual);
      end else begin
        failed = failed + 1;
        $display("FAIL expected=%h actual=%h",
                 expected, actual);
      end
    end
  endtask

  task reset_processor;
    begin
      @(negedge clk);
      rst = 1;
      @(posedge clk);
      #1;
      @(negedge clk);
      rst = 0;
    end
  endtask

  initial begin
    #1;
    $display("Starting SYSTEM instruction test...");

    // Test 1: Unsupported ECALL
    dut.imem.memory[0] = 32'h00500093; // ADDI x1,x0,5
    dut.imem.memory[1] = 32'h00000073; // ECALL
    dut.imem.memory[2] = 32'h00700113; // Must not execute

    reset_processor();
    repeat (6) @(posedge clk);
    #1;

    check(dut.rf.registers[1], 32'd5);
    check(dut.rf.registers[2], 32'd0);
    check(pc, 32'd4);
    check({31'd0, execution_valid}, 32'd0);
    check({dut.dmem.memory[3],
           dut.dmem.memory[2],
           dut.dmem.memory[1],
           dut.dmem.memory[0]}, 32'd0);

    // Test 2: Unsupported EBREAK
    dut.imem.memory[1] = 32'h00100073; // EBREAK

    reset_processor();
    repeat (6) @(posedge clk);
    #1;

    check(dut.rf.registers[1], 32'd5);
    check(dut.rf.registers[2], 32'd0);
    check(pc, 32'd4);
    check({31'd0, execution_valid}, 32'd0);
    check({dut.dmem.memory[3],
           dut.dmem.memory[2],
           dut.dmem.memory[1],
           dut.dmem.memory[0]}, 32'd0);

    $display("--------------------------");
    $display("Passed: %0d", passed);
    $display("Failed: %0d", failed);

    if (passed == 10 && failed == 0)
      $display("SYSTEM INSTRUCTION TEST PASSED");
    else
      $fatal(1, "SYSTEM INSTRUCTION TEST FAILED");

    $finish;
  end

endmodule
